# Frontend (Vite) — safe to expose in the browser bundle. Set the same values
# in your Vercel project's Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used only by scripts/gmail-sync.mjs (GitHub Actions / local runs). NEVER
# prefix these with VITE_ or they'd end up in the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=liyang@initia.sg
ACCOUNTS_EMAIL=accounts@initia.sg
